PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/kaicho
JWT_SECRET=change-me
ADMIN_KEY=change-me-admin-key

JWT_EXPIRES_IN=30d

COOKIE_NAME=kaicho_session
COOKIE_MAX_AGE_DAYS=30
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Comma-separated list of allowed browser origins for CORS (no trailing slash,
# no path). Example: http://localhost:3000,https://staging.example.com
FRONTEND_ORIGIN=http://localhost:3000

OTP_LENGTH=4
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_OTP_MAX=10
RATE_LIMIT_LOCATION_MAX=120

SMS_PROVIDER=console
DEFAULT_COUNTRY_CODE=+91

# --- Location / geocoding (storefront "choose your delivery area") ---
# The /api/location/* module is the only thing that talks to a geocoder, so
# no key is ever exposed to the browser. Defaults use keyless OpenStreetMap
# Nominatim; switch LOCATION_PROVIDER to google/mapbox and set the key to
# swap providers (impl seam in location.provider.ts).
LOCATION_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=KaichoFoods/1.0 (+https://kaicho.in)
IP_GEO_BASE_URL=https://ipapi.co
LOCATION_CACHE_TTL_MINUTES=60
# GOOGLE_MAPS_API_KEY=
# MAPBOX_TOKEN=

STORAGE_PROVIDER=local
MEDIA_BASE_PATH=uploads/media
# Set STORAGE_PROVIDER=cloudinary to ship media to Cloudinary instead of
# local disk (impl seam in modules/media/storage/index.ts). Get these three
# from the Cloudinary dashboard: Settings -> API Keys. Required only when
# STORAGE_PROVIDER=cloudinary — leave blank for local.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_IMAGE_FILE_SIZE_MB=10
MAX_PDF_FILE_SIZE_MB=20
MAX_MEDIA_FILES_PER_REQUEST=10
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
IMAGE_THUMBNAIL_WIDTH=300
IMAGE_MEDIUM_WIDTH=800
IMAGE_OPTIMIZED_WIDTH=1600
MEDIA_TEMPORARY_TTL_HOURS=24
RATE_LIMIT_MEDIA_UPLOAD_MAX=30
RATE_LIMIT_MEDIA_DELETE_MAX=60

# Razorpay. Blank is fine locally (payments simply can't be completed), but
# production MUST set real values — an empty secret makes every payment
# signature/webhook check fail closed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RATE_LIMIT_CHECKOUT_MAX=20

# Courier aggregator (Shiprocket). Blank = shipments are entered manually in
# the admin panel. Fill in to enable an automated integration later.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
