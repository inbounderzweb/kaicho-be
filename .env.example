PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/kaicho
JWT_SECRET=change-me
ADMIN_KEY=change-me-admin-key

JWT_EXPIRES_IN=30d

COOKIE_NAME=kaicho_session
COOKIE_MAX_AGE_DAYS=30
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

FRONTEND_ORIGIN=http://localhost:3000

OTP_LENGTH=4
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_OTP_MAX=10

SMS_PROVIDER=console
DEFAULT_COUNTRY_CODE=+91

STORAGE_PROVIDER=local
MEDIA_BASE_PATH=uploads/media
MAX_IMAGE_FILE_SIZE_MB=10
MAX_PDF_FILE_SIZE_MB=20
MAX_MEDIA_FILES_PER_REQUEST=10
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
IMAGE_THUMBNAIL_WIDTH=300
IMAGE_MEDIUM_WIDTH=800
IMAGE_OPTIMIZED_WIDTH=1600
MEDIA_TEMPORARY_TTL_HOURS=24
RATE_LIMIT_MEDIA_UPLOAD_MAX=30
RATE_LIMIT_MEDIA_DELETE_MAX=60
